<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icona incrustada a l'.exe (Explorador, barra de tasques, propietats). -->
    <ApplicationIcon>Assets/icona.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>ProgramacioDocent</AssemblyName>
    <RootNamespace>ProgramacioDocent</RootNamespace>
    <Version>2.1.1</Version>
    <Company>Programació Docent</Company>
    <Product>Programació Docent</Product>

    <!-- Idioma: cal mantenir globalització per a CultureInfo ca-ES -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ca</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
    <PackageReference Include="ClosedXML" Version="0.104.1" />
  </ItemGroup>

  <!--
    Referències directes per fixar versions corregides de dependències
    transitives amb vulnerabilitats conegudes (defensa en profunditat):
      - SQLitePCLRaw.lib.e_sqlite3 3.50.3: conté el binari natiu de SQLite 3.50.3,
        que corregeix CVE-2025-6965 (GHSA-2m69-gcr7-jv3q). És el paquet que porta
        la biblioteca nativa; Microsoft.Data.Sqlite l'inicialitza automàticament.
      - System.IO.Packaging 8.0.1: corregeix DoS CVE-2024-43484 (GHSA-f32c-w444-8ppv)
    Encara que el vector d'atac real en aquesta app local és baix (només
    processem dades pròpies), pinem les versions segures per higiene.
  -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="System.IO.Packaging" Version="8.0.1" />
    <!-- Tmds.DBus.Protocol només s'usa al backend de Linux (D-Bus). En el nostre
         objectiu Windows no s'executa mai, però pinem una versió sense la
         vulnerabilitat GHSA-xrw6-gwf8-vvr9 per no arrossegar-la. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

</Project>
