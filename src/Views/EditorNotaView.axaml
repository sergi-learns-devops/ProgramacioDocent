<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProgramacioDocent.ViewModels"
             x:Class="ProgramacioDocent.Views.EditorNotaView"
             x:DataType="vm:MainWindowViewModel">

    <!-- Contingut reutilitzable de l'editor de notes. S'usa tant a la finestra
         flotant (modal) com als panells fixos (inferior/dret). El DataContext
         és sempre el MainWindowViewModel.
         Usem un Grid amb files explícites (capçalera Auto, TextBox *, botons Auto)
         perquè el TextBox s'encongeixi segons l'espai disponible i mai se solapi,
         tant en un panell baix (inferior) com en un de prim (dret) o al modal. -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding TitolNota}" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SubtitolNota}" Foreground="{DynamicResource BrushTextSecondary}"
                           FontSize="12" TextWrapping="Wrap"/>
                <TextBlock Foreground="{DynamicResource BrushWarningHoliday}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                           Text="Protecció de dades: evita escriure noms complets d'alumnes; fes servir inicials o codis."/>
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Command="{Binding CancelaNotaCommand}"
                    VerticalAlignment="Top" Padding="8,2" Margin="8,0,0,0"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource BrushTextSecondary}"
                    ToolTip.Tip="Tanca la nota sense desar"/>
        </Grid>

        <TextBox Grid.Row="1" Text="{Binding TextNota}" AcceptsReturn="True" TextWrapping="Wrap"
                 Watermark="Escriu aquí les notes sobre la classe i els alumnes…"
                 VerticalContentAlignment="Top" MinHeight="60"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="Desat ✓" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushSuccess}" FontWeight="SemiBold"
                       IsVisible="{Binding NotaDesadaRecentment}"/>
            <Button Content="Cancel·la" Command="{Binding CancelaNotaCommand}" Padding="16,8"/>
            <Button Content="Desa la nota" Classes="accent"
                    Command="{Binding DesaNotaCommand}" Padding="16,8"/>
        </StackPanel>
    </Grid>
</UserControl>
