<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProgramacioDocent.ViewModels"
        xmlns:views="clr-namespace:ProgramacioDocent.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="ProgramacioDocent.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icona.ico"
        Title="Programació Docent"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <!-- ================= CONTINGUT PRINCIPAL ================= -->
        <DockPanel LastChildFill="True">

            <!-- Capçalera -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource BrushHeader}" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Programació Docent" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource BrushHeaderText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TitolSetmana}" FontSize="13"
                               Foreground="{DynamicResource BrushHeaderText}" Opacity="0.75" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TabControl DockPanel.Dock="Top" Margin="8">

                <!-- ====== PESTANYA HORARI ====== -->
                <TabItem Header="Horari">
                    <DockPanel LastChildFill="True" Margin="8">

                        <!-- Barra de navegació de setmanes -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource BrushSurfaceAlt}"
                                CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="◀ Setmana anterior" Command="{Binding SetmanaAnteriorCommand}"/>
                                <Button Content="Avui" Command="{Binding SetmanaAvuiCommand}"/>
                                <Button Content="Setmana següent ▶" Command="{Binding SetmanaSeguentCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- Cartell de dies festius de la setmana -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8" CornerRadius="6" Padding="10,6"
                                Background="{DynamicResource BrushHolidayColumn}"
                                BorderBrush="{DynamicResource BrushWarningHoliday}" BorderThickness="1">
                            <TextBlock Text="{Binding InfoDia}"
                                       Foreground="{DynamicResource BrushWarningHoliday}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Missatge d'ajuda -->
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   Text="Fes clic sobre un bloc de classe per afegir o editar les notes d'aquella setmana. Els blocs amb un punt verd ja tenen notes. La columna d'avui es ressalta i els dies festius es mostren atenuats."/>

                        <!-- Capçalera de dies (fixa, alineada amb la graella) -->
                        <Grid DockPanel.Dock="Top" x:Name="CapceleraCalendari"
                              ColumnDefinitions="56,*,*,*,*,*" Margin="0,0,0,4">
                            <ItemsControl Grid.Column="1" Grid.ColumnSpan="5" ItemsSource="{Binding DiesCapcalera}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiaCapceleraVm">
                                        <Border Margin="2" CornerRadius="4" Padding="4,3"
                                                Background="{DynamicResource BrushSurfaceAlt}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Titol}" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding SubTitol}" FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Graella tipus calendari (es construeix al codi darrere) -->
                        <ScrollViewer>
                            <Grid x:Name="CalendariHost" Margin="0,0,0,6"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- ====== PESTANYA INFORMES ====== -->
                <TabItem Header="Informes">
                    <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Generació d'informes" FontSize="18" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                   Text="Genera un informe amb totes les notes preses, ordenades per assignatura. Tria el període i el format de sortida."/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Període" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding PeriodesInforme}"
                                      SelectedItem="{Binding PeriodeSeleccionat}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Format del fitxer" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding FormatsInforme}"
                                      SelectedItem="{Binding FormatSeleccionat}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Button Content="Genera l'informe" Classes="accent"
                                Click="OnGeneraInforme" HorizontalAlignment="Left" Padding="16,8"/>

                        <TextBlock Text="{Binding MissatgeInforme}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource BrushSuccess}"/>
                    </StackPanel>
                </TabItem>

                <!-- ====== PESTANYA CALENDARI / INFORMACIÓ ====== -->
                <TabItem Header="Informació">
                    <ScrollViewer>
                        <StackPanel Margin="24" Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="Curs 2026-2027 · Catalunya" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}"
                                       Text="Inici de curs: 8 de setembre de 2026. Fi de curs: 21 de juny de 2027."/>
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Dies no lectius precarregats:"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                       Text="• 11/09/2026 Diada Nacional de Catalunya&#x0a;• 12/10/2026 Festa Nacional d'Espanya&#x0a;• 08/12/2026 La Immaculada&#x0a;• Vacances de Nadal: 22/12/2026 – 07/01/2027&#x0a;• Vacances de Setmana Santa: 20/03/2027 – 29/03/2027&#x0a;• 01/05/2027 Festa del Treball"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}" FontStyle="Italic"
                                       Text="Els dies de lliure disposició els fixa cada centre i es poden afegir manualment. Recorda: en centres privats les dates poden variar lleugerament."/>
                            <Border Background="{DynamicResource BrushHolidayColumn}"
                                    BorderBrush="{DynamicResource BrushWarningHoliday}" BorderThickness="1"
                                    CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Protecció de dades (RGPD)" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}"
                                               Text="Les dades es desen únicament en aquest equip. Es recomana no escriure noms complets d'alumnes a les notes; feu servir inicials o codis."/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding RutaDades, StringFormat='Ubicació de les dades: {0}'}"
                                       Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ====== PESTANYA CONFIGURACIÓ ====== -->
                <TabItem Header="Configuració">
                    <ScrollViewer>
                        <StackPanel Margin="24" Spacing="24" MaxWidth="820" HorizontalAlignment="Left">

                            <!-- Aparença / Tema -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Aparença" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Mode de color de l'aplicació." Foreground="{DynamicResource BrushTextSecondary}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Tema:" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding OpcionsTema}"
                                              SelectedItem="{Binding TemaSeleccionat}" Width="200"/>
                                </StackPanel>
                                <TextBlock Foreground="{DynamicResource BrushTextSecondary}" FontSize="12"
                                           Text="'Sistema' segueix la configuració de Windows. El canvi s'aplica immediatament."/>
                            </StackPanel>

                            <Separator/>

                            <!-- Perfil del professor -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Perfil del professor" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Informació bàsica (opcional). Es podrà mostrar als informes en el futur."
                                           Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding ProfNom}" Watermark="Nom" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cognoms" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ProfCognoms}" Watermark="Cognoms" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Centre" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding ProfCentre}" Watermark="Nom del centre educatiu" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Departament" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding ProfDepartament}" Watermark="p. ex. Ciències" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Correu" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding ProfEmail}" Watermark="correu@centre.cat" Margin="0,4"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Desa el perfil" Classes="accent" Command="{Binding DesaPerfilCommand}"/>
                                    <TextBlock Text="{Binding MissatgePerfil}" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Separator/>

                            <!-- Edició de l'horari -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Assignatures i horari" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Defineix aquí les assignatures. Per posar-les a l'horari, ves a la pestanya Horari i fes clic en un dia i una hora."/>

                                <TextBlock Text="Assignatures" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <ItemsControl ItemsSource="{Binding AssignaturesConfig}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2" Foreground="{DynamicResource BrushTextPrimary}">
                                                <Run Text="{Binding Nom}"/>
                                                <Run Text="{Binding Curs, StringFormat=' ({0})'}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid ColumnDefinitions="*,*,Auto" MaxWidth="480" HorizontalAlignment="Left">
                                    <TextBox Grid.Column="0" Text="{Binding NovaAssignaturaNom}" Watermark="Nom"/>
                                    <TextBox Grid.Column="1" Text="{Binding NovaAssignaturaCurs}" Watermark="Curs" Margin="6,0,0,0"/>
                                    <Button Grid.Column="2" Content="+ Afegeix" Command="{Binding AfegeixAssignaturaConfigCommand}" Margin="6,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Classes de l'horari actual" FontWeight="SemiBold" Margin="0,8,0,0"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Per editar o eliminar una classe, fes clic sobre el seu bloc a la pestanya Horari."/>
                                <ItemsControl ItemsSource="{Binding ClassesConfig}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2" Foreground="{DynamicResource BrushTextPrimary}">
                                                <Run Text="{Binding DiaSetmana, Converter={StaticResource DiaConverter}}"/>
                                                <Run Text=" · "/><Run Text="{Binding Assignatura.Nom}"/>
                                                <Run Text=" · "/><Run Text="{Binding Etiqueta}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MissatgeHorari}" Foreground="{DynamicResource BrushSuccess}"/>
                            </StackPanel>

                            <Separator/>

                            <!-- Dies de lliure disposició -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Dies de lliure disposició" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Afegeix els dies no lectius propis del centre. Es mostraran atenuats a l'horari, com els festius."/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <DatePicker SelectedDate="{Binding NovaDataLliure}"/>
                                    <TextBox Text="{Binding DescripcioLliure}" Watermark="Descripció (opcional)" Width="220"/>
                                    <Button Content="+ Afegeix" Command="{Binding AfegeixDiaLliureCommand}"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding DiesLliure}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2" MaxWidth="480" HorizontalAlignment="Left">
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrushTextPrimary}">
                                                    <Run Text="{Binding Data, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                                    <Run Text=" · "/><Run Text="{Binding Nom}"/>
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="Elimina"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).EliminaDiaLliureCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MissatgeLliure}" Foreground="{DynamicResource BrushSuccess}"/>
                            </StackPanel>

                            <Separator/>

                            <!-- Còpies de seguretat -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Còpies de seguretat" FontSize="18" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Es fa una còpia automàtica en obrir l'aplicació. També pots crear-ne una manualment o restaurar-ne una d'anterior."/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Crea una còpia ara" Command="{Binding CreaCopiaSeguretatCommand}"/>
                                    <Button Content="Restaura la seleccionada" Command="{Binding RestauraCopiaSeguretatCommand}"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Copies}" SelectedItem="{Binding CopiaSeleccionada}"
                                         MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Descripcio}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding MissatgeBackup}" Foreground="{DynamicResource BrushAccent}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RutaDades, StringFormat='Ubicació de les dades: {0}'}"
                                           Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Separator/>

                            <!-- Actualitzacions -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Actualitzacions" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding VersioActualApp, StringFormat='Versió instal·lada: {0}'}"
                                           Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Comprova si hi ha una versió nova a GitHub. Aquesta és l'única funció que fa servir Internet, i només quan hi fas clic."/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Comprova si hi ha actualitzacions"
                                            Command="{Binding ComprovaActualitzacionsCommand}"
                                            IsEnabled="{Binding !ComprovantActualitzacio}"/>
                                    <Button Content="Baixa la nova versió" Classes="accent"
                                            Command="{Binding BaixaActualitzacioCommand}"
                                            IsVisible="{Binding HiHaActualitzacio}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MissatgeActualitzacio}" TextWrapping="Wrap" Foreground="{DynamicResource BrushAccent}"/>

                                <!-- Novetats de la versió nova -->
                                <Border IsVisible="{Binding HiHaActualitzacio}"
                                        Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="12" MaxHeight="160">
                                    <ScrollViewer>
                                        <TextBlock Text="{Binding NotesActualitzacio}" TextWrapping="Wrap" FontSize="12"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Instruccions d'actualització -->
                                <Border IsVisible="{Binding HiHaActualitzacio}"
                                        Background="{DynamicResource BrushSurfaceAlt}"
                                        BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1"
                                        CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Com actualitzar (sense perdre dades)" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource BrushTextPrimary}"
                                                   Text="1. Fes clic a 'Baixa la nova versió' i desa el ZIP.&#x0a;2. Tanca l'aplicació.&#x0a;3. Descomprimeix el ZIP A SOBRE de la carpeta actual (substituint els fitxers).&#x0a;4. Torna a obrir 'ProgramacioDocent.exe'.&#x0a;&#x0a;Les teves dades (horari, notes, perfil) es conserven perquè es desen a la carpeta 'dades', que no es toca. A més, es fa una còpia de seguretat automàtica en arrencar."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Separator/>

                            <!-- Esborrar dades -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Esborrar dades" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                           Text="Accions per esborrar dades. Totes fan una còpia de seguretat automàtica abans, de manera que es poden desfer restaurant la còpia des de l'apartat anterior."/>

                                <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="2">
                                            <Button Content="Buida l'horari" Command="{Binding BuidaHorariCommand}"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Text="Esborra assignatures, franjes i classes (i les seves notes) i torna a obrir l'assistent per refer l'horari. Útil si les hores o classes no són correctes."/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <Button Content="Esborra totes les notes" Command="{Binding EsborraNotesCommand}"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Text="Esborra només les notes; l'horari es conserva."/>
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <Button Content="Restableix-ho tot" Command="{Binding RestableixTotCommand}"/>
                                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Text="Esborra l'horari i totes les notes i torna a l'estat inicial (conserva festius, tema i perfil)."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding MissatgeEsborrat}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource BrushSuccess}"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- ================= OVERLAY: EDITOR DE NOTES ================= -->
        <Border IsVisible="{Binding MostraEditorNota}"
                Background="#88000000">
            <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Width="560" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                        <TextBlock Text="{Binding TitolNota}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SubtitolNota}" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <TextBlock Foreground="{DynamicResource BrushWarningHoliday}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Protecció de dades: evita escriure noms complets d'alumnes; fes servir inicials o codis."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                        <Button Content="Cancel·la" Command="{Binding CancelaNotaCommand}" Padding="16,8"/>
                        <Button Content="Desa la nota" Classes="accent"
                                Command="{Binding DesaNotaCommand}" Padding="16,8"/>
                    </StackPanel>

                    <TextBox Text="{Binding TextNota}" AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="Escriu aquí les notes sobre la classe i els alumnes…"
                             VerticalContentAlignment="Top" MinHeight="240"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- ================= OVERLAY: POP-UP DE CLASSE ================= -->
        <Border IsVisible="{Binding MostraPopupClasse}" Background="#88000000">
            <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Width="460"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding PopupTitol}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>

                    <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Dia" VerticalAlignment="Center" Margin="0,4"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,4" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding DiesSetmanaOpcions}" SelectedItem="{Binding PopupDia}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding, Converter={StaticResource DiaConverter}}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Hora inici" VerticalAlignment="Center" Margin="0,4"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding PopupHoraInici}" Watermark="09:00"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hora fi" VerticalAlignment="Center" Margin="0,4"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding PopupHoraFi}" Watermark="10:00"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Assignatura" VerticalAlignment="Center" Margin="0,4"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding PopupAssignatures}" SelectedItem="{Binding PopupAssignatura}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Nom}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Grup / Aula" VerticalAlignment="Center" Margin="0,4"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,*" Margin="0,4">
                            <TextBox Grid.Column="0" Text="{Binding PopupGrup}" Watermark="Grup"/>
                            <TextBox Grid.Column="1" Text="{Binding PopupAula}" Watermark="Aula" Margin="6,0,0,0"/>
                        </Grid>
                    </Grid>

                    <TextBlock Text="{Binding MissatgePopup}" Foreground="#E74C3C" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button Grid.Column="0" Content="Elimina" IsVisible="{Binding PopupEsEdicio}"
                                Command="{Binding EliminaClassePopupCommand}" Padding="14,8"/>
                        <Button Grid.Column="2" Content="Cancel·la" Command="{Binding CancelaPopupClasseCommand}" Padding="14,8"/>
                        <Button Grid.Column="3" Content="Desa" Classes="accent" Margin="8,0,0,0"
                                Command="{Binding DesaClassePopupCommand}" Padding="14,8"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= OVERLAY: CONFIRMACIÓ ================= -->
        <Border IsVisible="{Binding MostraConfirmacio}" Background="#88000000">
            <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Width="480"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding TitolConfirmacio}" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="{Binding TextConfirmacio}" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Cancel·la" Command="{Binding CancelaConfirmacioCommand}" Padding="16,8"/>
                        <Button Content="Sí, continua" Command="{Binding ConfirmaAccioCommand}" Padding="16,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= OVERLAY: ASSISTENT INICIAL ================= -->
        <Border IsVisible="{Binding MostraAssistent}" Background="#88000000">
            <Border Background="{DynamicResource BrushSurface}" CornerRadius="10" Width="620" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="Benvingut/da a Programació Docent" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource BrushTextSecondary}"
                                   Text="Per començar, indica les assignatures que imparteixes. Després, a la pestanya Horari, faràs clic en un dia i una hora per col·locar cada classe."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="6">
                        <TextBlock Text="{Binding MissatgeAssistent}" Foreground="#E74C3C" TextWrapping="Wrap"/>
                        <Button Content="Desa i comença" Classes="accent"
                                Command="{Binding CompletaAssistentCommand}"
                                HorizontalAlignment="Right" Padding="18,10"/>
                    </StackPanel>

                    <ScrollViewer>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Assignatures" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                            <ItemsControl ItemsSource="{Binding AssignaturesAssistent}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AssignaturaEditVm">
                                        <Grid ColumnDefinitions="*,*,Auto" Margin="0,2">
                                            <TextBox Grid.Column="0" Text="{Binding Nom}" Watermark="Nom (p.ex. Matemàtiques)"/>
                                            <TextBox Grid.Column="1" Text="{Binding Curs}" Watermark="Curs (p.ex. 1r ESO A)" Margin="6,0,0,0"/>
                                            <Button Grid.Column="2" Content="✕" Margin="6,0,0,0"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).EliminaAssignaturaAssistentCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Afegeix assignatura"
                                    Command="{Binding AfegeixAssignaturaAssistentCommand}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Panel>

    <Window.Resources>
        <views:DiaConverter x:Key="DiaConverter"/>
    </Window.Resources>
</Window>
