<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProgramacioDocent.ViewModels"
        xmlns:views="clr-namespace:ProgramacioDocent.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="ProgramacioDocent.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icona.ico"
        Title="Programació Docent"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Panel>
        <!-- ================= CONTINGUT PRINCIPAL ================= -->
        <DockPanel LastChildFill="True">

            <!-- Capçalera -->
            <Border DockPanel.Dock="Top" Background="#2C3E50" Padding="16,12">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Programació Docent" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TitolSetmana}" FontSize="13"
                               Foreground="#BDC3C7" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TabControl DockPanel.Dock="Top" Margin="8">

                <!-- ====== PESTANYA HORARI ====== -->
                <TabItem Header="Horari">
                    <DockPanel LastChildFill="True" Margin="8">

                        <!-- Barra de navegació de setmanes -->
                        <Border DockPanel.Dock="Top" Background="#ECF0F1"
                                CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="◀ Setmana anterior" Command="{Binding SetmanaAnteriorCommand}"/>
                                <Button Content="Avui" Command="{Binding SetmanaAvuiCommand}"/>
                                <Button Content="Setmana següent ▶" Command="{Binding SetmanaSeguentCommand}"/>
                                <TextBlock Text="{Binding InfoDia}" VerticalAlignment="Center"
                                           Margin="16,0,0,0" Foreground="#7F8C8D" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <!-- Capçalera de dies -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="110,*,*,*,*,*" Margin="0,0,0,4">
                            <TextBlock Grid.Column="0" Text="Hora" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Dilluns" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Dimarts" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="Dimecres" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="Dijous" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="Divendres" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Missatge d'ajuda -->
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#7F8C8D"
                                   Text="Fes clic sobre una classe per afegir o editar les notes d'aquella setmana. Les classes amb un punt verd ja tenen notes."/>

                        <!-- Graella d'horari -->
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding FilesHorari}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FilaHorariViewModel">
                                        <Grid ColumnDefinitions="110,*,*,*,*,*" Margin="0,0,0,6" MinHeight="64">
                                            <Border Grid.Column="0" Background="#F7F9FA"
                                                    CornerRadius="4" Margin="2">
                                                <TextBlock Text="{Binding Franja}" FontSize="12"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            </Border>

                                            <ContentControl Grid.Column="1" Content="{Binding Celles[0]}"
                                                            ContentTemplate="{StaticResource CellaTemplate}"/>
                                            <ContentControl Grid.Column="2" Content="{Binding Celles[1]}"
                                                            ContentTemplate="{StaticResource CellaTemplate}"/>
                                            <ContentControl Grid.Column="3" Content="{Binding Celles[2]}"
                                                            ContentTemplate="{StaticResource CellaTemplate}"/>
                                            <ContentControl Grid.Column="4" Content="{Binding Celles[3]}"
                                                            ContentTemplate="{StaticResource CellaTemplate}"/>
                                            <ContentControl Grid.Column="5" Content="{Binding Celles[4]}"
                                                            ContentTemplate="{StaticResource CellaTemplate}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <!-- ====== PESTANYA INFORMES ====== -->
                <TabItem Header="Informes">
                    <StackPanel Margin="24" Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Generació d'informes" FontSize="18" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D"
                                   Text="Genera un informe amb totes les notes preses, ordenades per assignatura. Tria el període i el format de sortida."/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Període" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding PeriodesInforme}"
                                      SelectedItem="{Binding PeriodeSeleccionat}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Format del fitxer" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding FormatsInforme}"
                                      SelectedItem="{Binding FormatSeleccionat}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <Button Content="Genera l'informe" Classes="accent"
                                Click="OnGeneraInforme" HorizontalAlignment="Left" Padding="16,8"/>

                        <TextBlock Text="{Binding MissatgeInforme}" TextWrapping="Wrap"
                                   Foreground="#27AE60"/>
                    </StackPanel>
                </TabItem>

                <!-- ====== PESTANYA CALENDARI / INFORMACIÓ ====== -->
                <TabItem Header="Informació">
                    <StackPanel Margin="24" Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Curs 2026-2027 · Catalunya" FontSize="18" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Inici de curs: 8 de setembre de 2026. Fi de curs: 21 de juny de 2027."/>
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Dies no lectius precarregats:"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#555"
                                   Text="• 11/09/2026 Diada Nacional de Catalunya&#x0a;• 12/10/2026 Festa Nacional d'Espanya&#x0a;• 08/12/2026 La Immaculada&#x0a;• Vacances de Nadal: 22/12/2026 – 07/01/2027&#x0a;• Vacances de Setmana Santa: 20/03/2027 – 29/03/2027&#x0a;• 01/05/2027 Festa del Treball"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D" FontStyle="Italic"
                                   Text="Els dies de lliure disposició els fixa cada centre i es poden afegir manualment. Recorda: en centres privats les dates poden variar lleugerament."/>
                        <Border Background="#FEF9E7" BorderBrush="#F1C40F" BorderThickness="1"
                                CornerRadius="6" Padding="12" Margin="0,8,0,0">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Protecció de dades (RGPD)" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="Les dades es desen únicament en aquest equip. Es recomana no escriure noms complets d'alumnes a les notes; feu servir inicials o codis."/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding RutaDades, StringFormat='Ubicació de les dades: {0}'}"
                                   Foreground="#7F8C8D" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </TabItem>

                <!-- ====== PESTANYA CONFIGURACIÓ ====== -->
                <TabItem Header="Configuració">
                    <ScrollViewer>
                        <StackPanel Margin="24" Spacing="24" MaxWidth="820" HorizontalAlignment="Left">

                            <!-- Aparença / Tema -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Aparença" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Mode de color de l'aplicació." Foreground="#7F8C8D"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Tema:" VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding OpcionsTema}"
                                              SelectedItem="{Binding TemaSeleccionat}" Width="200"/>
                                </StackPanel>
                                <TextBlock Foreground="#7F8C8D" FontSize="12"
                                           Text="'Sistema' segueix la configuració de Windows. El canvi s'aplica immediatament."/>
                            </StackPanel>

                            <Separator/>

                            <!-- Perfil del professor -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Perfil del professor" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Informació bàsica (opcional). Es podrà mostrar als informes en el futur."
                                           Foreground="#7F8C8D" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nom" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding ProfNom}" Watermark="Nom" Margin="0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cognoms" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ProfCognoms}" Watermark="Cognoms" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Centre" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding ProfCentre}" Watermark="Nom del centre educatiu" Margin="0,4"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Departament" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding ProfDepartament}" Watermark="p. ex. Ciències" Margin="0,4"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Correu" VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding ProfEmail}" Watermark="correu@centre.cat" Margin="0,4"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Desa el perfil" Classes="accent" Command="{Binding DesaPerfilCommand}"/>
                                    <TextBlock Text="{Binding MissatgePerfil}" Foreground="#27AE60" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <Separator/>

                            <!-- Edició de l'horari -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Edició de l'horari" FontSize="18" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D"
                                           Text="Afegeix assignatures i franjes, i col·loca classes a la graella. Els canvis es reflecteixen a la pestanya Horari."/>

                                <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto">
                                    <!-- Assignatures -->
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="Assignatures" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding AssignaturesConfig}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,2" Text="{Binding Nom}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnDefinitions="*,*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding NovaAssignaturaNom}" Watermark="Nom"/>
                                            <TextBox Grid.Column="1" Text="{Binding NovaAssignaturaCurs}" Watermark="Curs" Margin="6,0,0,0"/>
                                            <Button Grid.Column="2" Content="+" Command="{Binding AfegeixAssignaturaConfigCommand}" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Franjes -->
                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="Franjes horàries" FontWeight="SemiBold"/>
                                        <ItemsControl ItemsSource="{Binding FranjesConfig}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,2" Text="{Binding Etiqueta}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnDefinitions="*,*,Auto">
                                            <TextBox Grid.Column="0" Text="{Binding NovaFranjaInici}" Watermark="08:00"/>
                                            <TextBox Grid.Column="1" Text="{Binding NovaFranjaFi}" Watermark="09:00" Margin="6,0,0,0"/>
                                            <Button Grid.Column="2" Content="+" Command="{Binding AfegeixFranjaConfigCommand}" Margin="6,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Afegir classe -->
                                <TextBlock Text="Afegeix una classe a la graella" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding DiesSetmanaOpcions}"
                                              SelectedItem="{Binding NovaClasseDia}" Width="110">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding, Converter={StaticResource DiaConverter}}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AssignaturesConfig}"
                                              SelectedItem="{Binding NovaClasseAssignatura}" Width="160" Margin="6,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Nom}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding FranjesConfig}"
                                              SelectedItem="{Binding NovaClasseFranja}" Width="130" Margin="6,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Etiqueta}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="3" Text="{Binding NovaClasseGrup}" Watermark="Grup" Width="80" Margin="6,0,0,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding NovaClasseAula}" Watermark="Aula" Width="80" Margin="6,0,0,0"/>
                                    <Button Grid.Column="5" Content="Afegeix" Command="{Binding AfegeixClasseConfigCommand}" Margin="6,0,0,0"/>
                                </Grid>
                                <TextBlock Foreground="#7F8C8D" FontSize="12"
                                           Text="(El desplegable de dia mostra 1=Dilluns … 5=Divendres)"/>

                                <!-- Llista de classes existents -->
                                <TextBlock Text="Classes de l'horari actual" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <ItemsControl ItemsSource="{Binding ClassesConfig}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                    <Run Text="{Binding DiaSetmana, Converter={StaticResource DiaConverter}}"/>
                                                    <Run Text=" · "/><Run Text="{Binding Assignatura.Nom}"/>
                                                    <Run Text=" · "/><Run Text="{Binding Franja.Etiqueta}"/>
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="Elimina"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).EliminaClasseConfigCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding MissatgeHorari}" Foreground="#27AE60"/>
                            </StackPanel>

                            <Separator/>

                            <!-- Còpies de seguretat -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Còpies de seguretat" FontSize="18" FontWeight="Bold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D"
                                           Text="Es fa una còpia automàtica en obrir l'aplicació. També pots crear-ne una manualment o restaurar-ne una d'anterior."/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Crea una còpia ara" Command="{Binding CreaCopiaSeguretatCommand}"/>
                                    <Button Content="Restaura la seleccionada" Command="{Binding RestauraCopiaSeguretatCommand}"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Copies}" SelectedItem="{Binding CopiaSeleccionada}"
                                         MaxHeight="180">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Descripcio}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding MissatgeBackup}" Foreground="#2980B9" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RutaDades, StringFormat='Ubicació de les dades: {0}'}"
                                           Foreground="#7F8C8D" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Separator/>

                            <!-- Actualitzacions -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Actualitzacions" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding VersioActualApp, StringFormat='Versió instal·lada: {0}'}"
                                           Foreground="#7F8C8D"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D"
                                           Text="Comprova si hi ha una versió nova a GitHub. Aquesta és l'única funció que fa servir Internet, i només quan hi fas clic."/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Comprova si hi ha actualitzacions"
                                            Command="{Binding ComprovaActualitzacionsCommand}"
                                            IsEnabled="{Binding !ComprovantActualitzacio}"/>
                                    <Button Content="Baixa la nova versió" Classes="accent"
                                            Command="{Binding BaixaActualitzacioCommand}"
                                            IsVisible="{Binding HiHaActualitzacio}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MissatgeActualitzacio}" TextWrapping="Wrap" Foreground="#2980B9"/>

                                <!-- Novetats de la versió nova -->
                                <Border IsVisible="{Binding HiHaActualitzacio}"
                                        Background="#F4F6F7" CornerRadius="6" Padding="12" MaxHeight="160">
                                    <ScrollViewer>
                                        <TextBlock Text="{Binding NotesActualitzacio}" TextWrapping="Wrap" FontSize="12"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Instruccions d'actualització -->
                                <Border IsVisible="{Binding HiHaActualitzacio}"
                                        Background="#EAF7EE" BorderBrush="#27AE60" BorderThickness="1"
                                        CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Com actualitzar (sense perdre dades)" FontWeight="Bold"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                   Text="1. Fes clic a 'Baixa la nova versió' i desa el ZIP.&#x0a;2. Tanca l'aplicació.&#x0a;3. Descomprimeix el ZIP A SOBRE de la carpeta actual (substituint els fitxers).&#x0a;4. Torna a obrir 'ProgramacioDocent.exe'.&#x0a;&#x0a;Les teves dades (horari, notes, perfil) es conserven perquè es desen a la carpeta 'dades', que no es toca. A més, es fa una còpia de seguretat automàtica en arrencar."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- ================= OVERLAY: EDITOR DE NOTES ================= -->
        <Border IsVisible="{Binding MostraEditorNota}"
                Background="#88000000">
            <Border Background="White" CornerRadius="10" Width="560" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,12">
                        <TextBlock Text="{Binding TitolNota}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SubtitolNota}" Foreground="#7F8C8D"/>
                        <TextBlock Foreground="#B9770E" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Protecció de dades: evita escriure noms complets d'alumnes; fes servir inicials o codis."/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
                        <Button Content="Cancel·la" Command="{Binding CancelaNotaCommand}" Padding="16,8"/>
                        <Button Content="Desa la nota" Classes="accent"
                                Command="{Binding DesaNotaCommand}" Padding="16,8"/>
                    </StackPanel>

                    <TextBox Text="{Binding TextNota}" AcceptsReturn="True" TextWrapping="Wrap"
                             Watermark="Escriu aquí les notes sobre la classe i els alumnes…"
                             VerticalContentAlignment="Top" MinHeight="240"/>
                </DockPanel>
            </Border>
        </Border>

        <!-- ================= OVERLAY: ASSISTENT INICIAL ================= -->
        <Border IsVisible="{Binding MostraAssistent}" Background="#88000000">
            <Border Background="White" CornerRadius="10" Width="760" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="Benvingut/da a Programació Docent" FontSize="20" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D"
                                   Text="Defineix el teu horari inicial. Podràs editar-lo més endavant (reducció de jornada, canvis de curs, etc.)."/>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <Border Background="#2C3E50" CornerRadius="10" Padding="8,2" IsVisible="{Binding EsPas1}">
                                <TextBlock Text="Pas 1 de 2 · Franjes i assignatures" Foreground="White" FontSize="12"/>
                            </Border>
                            <Border Background="#2C3E50" CornerRadius="10" Padding="8,2" IsVisible="{Binding EsPas2}">
                                <TextBlock Text="Pas 2 de 2 · Col·loca les classes per dia" Foreground="White" FontSize="12"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="6">
                        <TextBlock Text="{Binding MissatgeAssistent}" Foreground="#E74C3C" TextWrapping="Wrap"/>
                        <!-- Pas 1: continuar -->
                        <Button Content="Continua →" Classes="accent" IsVisible="{Binding EsPas1}"
                                Command="{Binding ContinuaAssistentCommand}"
                                HorizontalAlignment="Right" Padding="18,10"/>
                        <!-- Pas 2: finalitzar -->
                        <Button Content="Comença a fer servir l'aplicació" Classes="accent" IsVisible="{Binding EsPas2}"
                                Command="{Binding CompletaAssistentCommand}"
                                HorizontalAlignment="Right" Padding="18,10"/>
                    </StackPanel>

                    <ScrollViewer>
                        <StackPanel>
                            <!-- ===== PAS 1: FRANJES I ASSIGNATURES ===== -->
                            <Grid ColumnDefinitions="*,16,*" IsVisible="{Binding EsPas1}">
                                <!-- Franjes -->
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="Franjes horàries" FontWeight="Bold"/>
                                    <ItemsControl ItemsSource="{Binding FranjesAssistent}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FranjaEditVm">
                                                <Grid ColumnDefinitions="*,Auto,*,Auto" Margin="0,2">
                                                    <TextBox Grid.Column="0" Text="{Binding HoraInici}" Watermark="08:00"/>
                                                    <TextBlock Grid.Column="1" Text="–" Margin="6,0" VerticalAlignment="Center"/>
                                                    <TextBox Grid.Column="2" Text="{Binding HoraFi}" Watermark="09:00"/>
                                                    <Button Grid.Column="3" Content="✕" Margin="6,0,0,0"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).EliminaFranjaAssistentCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Afegeix franja"
                                            Command="{Binding AfegeixFranjaAssistentCommand}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="12"
                                               Text="En afegir una franja, l'hora d'inici s'omple automàticament amb la de fi de l'anterior."/>
                                </StackPanel>

                                <!-- Assignatures -->
                                <StackPanel Grid.Column="2" Spacing="6">
                                    <TextBlock Text="Assignatures" FontWeight="Bold"/>
                                    <ItemsControl ItemsSource="{Binding AssignaturesAssistent}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AssignaturaEditVm">
                                                <Grid ColumnDefinitions="*,*,Auto" Margin="0,2">
                                                    <TextBox Grid.Column="0" Text="{Binding Nom}" Watermark="Nom (p.ex. Matemàtiques)"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Curs}" Watermark="Curs (p.ex. 1r ESO A)" Margin="6,0,0,0"/>
                                                    <Button Grid.Column="2" Content="✕" Margin="6,0,0,0"
                                                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).EliminaAssignaturaAssistentCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="+ Afegeix assignatura"
                                            Command="{Binding AfegeixAssignaturaAssistentCommand}"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="12" Margin="0,8,0,0"
                                               Text="Al pas següent col·locaràs cada assignatura al dia i la franja corresponents."/>
                                </StackPanel>
                            </Grid>

                            <!-- ===== PAS 2: COL·LOCAR CLASSES PER DIA ===== -->
                            <StackPanel IsVisible="{Binding EsPas2}" Spacing="8">
                                <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D"
                                           Text="Tria el dia, l'assignatura i la franja, i afegeix la classe. Repeteix-ho per a cada classe de la setmana (dilluns a divendres)."/>
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding DiesSetmanaOpcions}"
                                              SelectedItem="{Binding NovaClasseDia}" Width="90">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding, Converter={StaticResource DiaConverter}}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AssignaturesConfig}"
                                              SelectedItem="{Binding NovaClasseAssignatura}" Width="170" Margin="6,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Nom}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding FranjesConfig}"
                                              SelectedItem="{Binding NovaClasseFranja}" Width="130" Margin="6,0,0,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Etiqueta}"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="3" Text="{Binding NovaClasseGrup}" Watermark="Grup" Width="70" Margin="6,0,0,0"/>
                                    <TextBox Grid.Column="4" Text="{Binding NovaClasseAula}" Watermark="Aula" Width="70" Margin="6,0,0,0"/>
                                    <Button Grid.Column="5" Content="Afegeix classe" Margin="6,0,0,0"
                                            Command="{Binding AfegeixClasseAssistentCommand}"/>
                                </Grid>

                                <TextBlock Text="Classes afegides:" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                <ItemsControl ItemsSource="{Binding ClassesConfig}" MaxHeight="220">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                                    <Run Text="{Binding DiaSetmana, Converter={StaticResource DiaConverter}}"/>
                                                    <Run Text=" · "/><Run Text="{Binding Assignatura.Nom}"/>
                                                    <Run Text=" · "/><Run Text="{Binding Franja.Etiqueta}"/>
                                                </TextBlock>
                                                <Button Grid.Column="1" Content="✕"
                                                        Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).EliminaClasseAssistentCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock TextWrapping="Wrap" Foreground="#7F8C8D" FontSize="12"
                                           Text="Pots deixar-ho aquí i afegir més classes més endavant des de Configuració → Edició de l'horari."/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Panel>

    <Window.Resources>
        <views:DiaConverter x:Key="DiaConverter"/>
        <!-- Plantilla d'una cel·la de classe a la graella -->
        <DataTemplate x:Key="CellaTemplate" x:DataType="vm:ClasseCellaViewModel">
            <Panel Margin="2">
                <!-- Cel·la buida (sense classe) -->
                <Border IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNull}}"
                        Background="#FAFBFC" CornerRadius="4" BorderBrush="#ECECEC" BorderThickness="1"/>
                <!-- Cel·la amb classe -->
                <Button IsVisible="{Binding ., Converter={x:Static ObjectConverters.IsNotNull}}"
                        Click="OnClasseClick" Padding="0" HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0">
                    <Border CornerRadius="4" Padding="8" HorizontalAlignment="Stretch"
                            Background="{Binding Color}">
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Ellipse Width="8" Height="8" Fill="#27AE60"
                                         VerticalAlignment="Center"
                                         IsVisible="{Binding TeNota}"/>
                                <TextBlock Text="{Binding NomAssignatura}" FontWeight="Bold"
                                           Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Detall}" FontSize="11"
                                       Foreground="#F5F5F5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Button>
            </Panel>
        </DataTemplate>
    </Window.Resources>
</Window>
